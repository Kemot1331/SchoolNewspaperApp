@using SchoolNewspaperBlazorApp.Data
@using SchoolNewspaperBlazorApp.Interfaces.Service
@using SchoolNewspaperBlazorApp.Service
@inject ToastService toastService
<div class="article-grid">
    @foreach (var article in Articles)
    {
        var imageUrl = GetImageUrl(article.FileId);

        if (permissions == true)
        {
            <div class="article-card">
                <div class="article-card__img-wrap">
                    @if (imageUrl.Length > 0)
                    {
                        <img src="@imageUrl" class="article-card__img-bg" alt="" aria-hidden="true" loading="lazy">
                        <img src="@imageUrl" class="article-card__img" alt="@article.Title" loading="lazy">
                    }
                    else
                    {
                        <div class="article-card__placeholder">Brak zdjęcia okładki</div>
                    }
                </div>
                <div class="article-card__body">
                    <h5 class="article-card__title">@article.Title</h5>
                    <p class="article-card__text">@ArticleContent.PlainText(article.Text)</p>
                    <div class="article-card__footer">
                        <span class="article-card__author">@article.AuthorDisplay</span>
                        @if (CanDelete)
                        {
                            if (confirmDeleteId == article.Id)
                            {
                                <span class="small">Na pewno?</span>
                                <button class="btn btn-sm btn-danger" @onclick="() => RemoveArticleByIdAsync(article.Id)">
                                    Tak, usuń
                                </button>
                                <button class="btn btn-sm btn-outline-primary" @onclick="() => confirmDeleteId = null">
                                    Nie
                                </button>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => confirmDeleteId = article.Id">
                                    Usuń artykuł
                                </button>
                            }
                        }
                        @if (CanEdit)
                        {
                            <button class="btn btn-sm btn-outline-primary" @onclick="() => SendDataToEdit(article.Id)">
                                Edytuj artykuł
                            </button>
                        }
                    </div>
                </div>
            </div>
        }
        else
        {
            <NavLink class="article-card article-card--link" href="@($"/article/{article.Id}")">
                <div class="article-card__img-wrap">
                    @if (imageUrl.Length > 0)
                    {
                        <img src="@imageUrl" class="article-card__img-bg" alt="" aria-hidden="true" loading="lazy">
                        <img src="@imageUrl" class="article-card__img" alt="@article.Title" loading="lazy">
                    }
                    else
                    {
                        <div class="article-card__placeholder">Brak zdjęcia okładki</div>
                    }
                </div>
                <div class="article-card__body">
                    <h5 class="article-card__title">@article.Title</h5>
                    <p class="article-card__text">@ArticleContent.PlainText(article.Text)</p>
                    <div class="article-card__footer">
                        <span class="article-card__author">@article.AuthorDisplay</span>
                        <span class="article-card__more">Czytaj więcej →</span>
                    </div>
                </div>
            </NavLink>
        }
    }
</div>

@code {
    [Parameter]
    public EventCallback<int> onEdit { get; set; }
    [Parameter]
    public List<Article> Articles { get; set; } = new();
    [Parameter]
    public bool permissions { get; set; }
    [Parameter]
    public bool CanEdit { get; set; }
    [Parameter]
    public bool CanDelete { get; set; }
    [Inject]
    public required IArticleService articleService { get; set; }
    [Inject]
    public required IFileService fileService { get; set; }
    Dictionary<int, string> imageUrls = new Dictionary<int, string>();
    private int? confirmDeleteId;

    protected override async Task OnParametersSetAsync()
    {
        imageUrls.Clear();

        // jedno zapytanie na każde unikalne zdjęcie; brak pliku w bazie nie przewraca całej listy
        foreach (var fileId in Articles.Select(a => a.FileId).Distinct())
        {
            var fileName = await fileService.TryGetFileNameByIdAsync(fileId);
            if (fileName != null)
            {
                imageUrls[fileId] = $"/Images/{fileName}";
            }
        }
    }

    private string GetImageUrl(int fileId)
    {
        return imageUrls.TryGetValue(fileId, out var url) ? url : "";
    }

    public async Task RemoveArticleByIdAsync(int id)
    {
        confirmDeleteId = null;

        try
        {
            await articleService.RemoveArticleByIdAsync(id);
            Article? article = Articles.FirstOrDefault(a => a.Id == id);
            if(article != null)
            {
                Articles.Remove(article);
            }
            toastService.Success("Artykuł został usunięty.");
        }
        catch (UnauthorizedAccessException)
        {
            toastService.Error("Nie masz uprawnień do usuwania artykułów.");
        }
        catch (Exception)
        {
            toastService.Error("Nie udało się usunąć artykułu.");
        }
    }

    public async Task SendDataToEdit(int id)
    {
        await onEdit.InvokeAsync(id);
    }
}

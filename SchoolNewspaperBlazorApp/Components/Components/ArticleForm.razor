@using SchoolNewspaperBlazorApp.Data
@using SchoolNewspaperBlazorApp.Interfaces.Service
@using SchoolNewspaperBlazorApp.Service
@inject IArticleService articleService
@inject IFileService fileService
@inject ToastService toastService
    
<div class="add-article-form">
    <h1 class="add-article-form__title">@(IsEdit ? "Edytuj artykuł" : Texts.Heading)</h1>

    <label class="form-label">@(IsEdit ? "Nowe zdjęcie (zastąpi obecne)" : "Zdjęcia")</label>
    <InputFile @key="formKey"
               OnChange="ChoosePhotos"
               accept="image/*"
               multiple="@(!IsEdit)"
               class="form-control mb-3" />

    @if (photos.Count > 0)
    {
        <div class="d-flex flex-wrap gap-2 mb-3">
            @for (var i = 0; i < photos.Count; i++)
            {
                var index = i;
                <div style="position: relative;">
                    <img src="@photos[index].Preview"
                         alt="Zdjęcie @(index + 1)"
                         style="width: 96px; height: 96px; object-fit: cover; border-radius: 10px; border: 1px solid #dde3ec;" />

                    @if (index == 0)
                    {
                        <span style="position: absolute; left: 4px; bottom: 4px; padding: 1px 7px; border-radius: 999px; background: #183a68; color: #fff; font-size: 10px; font-weight: 700;">
                            Okładka
                        </span>
                    }

                    <button type="button"
                            class="btn btn-sm btn-danger"
                            style="position: absolute; top: 2px; right: 2px; padding: 0 7px; line-height: 1.4;"
                            aria-label="Usuń zdjęcie"
                            @onclick="() => RemovePhoto(index)">×</button>
                </div>
            }
        </div>
    }

    <form @onsubmit="SubmitForm" @onsubmit:preventDefault>
        
        <label class="form-label">Typ wydarzenia</label>
        <select value="@(eventType?.ToString() ?? "")" @onchange="OnTypeChanged" class="form-select mb-4">
            <option value="">Zwykły artykuł (bez typu)</option>
            @foreach (var t in Enum.GetValues<ArticleType>())
            {
                <option value="@t">@t.ToLabel()</option>
            }
        </select>
        
        <label class="form-label">@Texts.TitleLabel</label>
        <input @bind="title" class="form-control mb-3"
               placeholder="@Texts.TitlePlaceholder" />

        <label class="form-label">@Texts.TextLabel</label>
        <textarea @bind="text" class="form-control mb-3"
                  rows="6" placeholder="@Texts.TextPlaceholder" style="resize: none"></textarea>

        <button type="submit" class="btn btn-primary w-100">@(IsEdit ? "Zatwierdź edycje" : Texts.Submit)</button>

        @if (IsEdit && CanDelete)
        {
            <button type="button" class="btn btn-outline-danger w-100 mt-2" @onclick="DeleteAsync">
                Usuń artykuł
            </button>
        }
    </form>
</div>


@code {
    private const int MaxFiles = 10;
    private readonly List<(IBrowserFile File, string Preview)> photos = new();

    [Parameter]
    public bool IsEdit { get; set; }
    [Parameter]
    public Article? Article { get; set; }
    [Parameter]
    public bool CanDelete { get; set; }
    [Parameter]
    public EventCallback OnDeleted { get; set; }

    private string title = "";
    private string text = "";
    private ArticleType? eventType;
    private int formKey;

    // Teksty formularza zależne od wybranej kategorii
    private sealed record FormTexts(
        string Heading,
        string TitleLabel,
        string TitlePlaceholder,
        string TextLabel,
        string TextPlaceholder,
        string Submit);

    private FormTexts Texts => GetTexts(eventType);

    private static FormTexts GetTexts(ArticleType? type) => type switch
    {
        ArticleType.Announcements => new("Dodaj ogłoszenie",
            "Tytuł ogłoszenia", "Tytuł ogłoszenia...",
            "Treść ogłoszenia", "Treść ogłoszenia...",
            "Dodaj ogłoszenie"),
        ArticleType.Substitute => new("Dodaj zastępstwo",
            "Informacje o zastępstwie", "Np. Zastępstwo z matematyki",
            "Szczegóły zastępstwa", "Klasa, lekcja, nauczyciel...",
            "Dodaj zastępstwo"),
        ArticleType.Events => new("Dodaj wydarzenie",
            "Nazwa wydarzenia", "Nazwa wydarzenia...",
            "Opis wydarzenia", "Opis wydarzenia...",
            "Dodaj wydarzenie"),
        ArticleType.Competitions => new("Dodaj zawody",
            "Nazwa zawodów", "Nazwa zawodów...",
            "Opis zawodów i wyniki", "Opisz zawody i wyniki...",
            "Dodaj zawody"),
        ArticleType.Admissions => new("Dodaj informację o rekrutacji",
            "Tytuł informacji rekrutacyjnej", "Np. Rekrutacja na rok szkolny...",
            "Informacje o rekrutacji", "Terminy, zasady, wymagania...",
            "Dodaj informację o rekrutacji"),
        ArticleType.Exams => new("Dodaj egzamin",
            "Nazwa egzaminu", "Np. Egzamin ósmoklasisty",
            "Informacje o egzaminie", "Terminy i ważne informacje...",
            "Dodaj egzamin"),
        ArticleType.StudentCouncil => new("Dodaj informację samorządu",
            "Tytuł informacji samorządu", "Tytuł informacji...",
            "Treść informacji", "Informacja od samorządu...",
            "Dodaj informację samorządu"),
        _ => new("Dodaj artykuł",
            "Tytuł", "Wpisz tytuł...",
            "Treść", "Treść artykułu...",
            "Dodaj artykuł")
    };

    private void OnTypeChanged(ChangeEventArgs e)
    {
        eventType = Enum.TryParse<ArticleType>(e.Value?.ToString(), out var parsed) ? parsed : null;
    }

    protected override void OnParametersSet()
    {
        if (IsEdit && Article != null)
        {
            title = Article.Title;
            text = Article.Text;
            eventType = Article.EventsType;
        }
    }

    private async Task SubmitForm()
    {
        if (!IsEdit && photos.Count == 0)
        {
            toastService.Error("Dodając artykuł, musisz dodać zdjęcie.");
            return;
        }

        try
        {
            if (IsEdit && Article != null)
            {
                // bez nowego zdjęcia zostaje dotychczasowa okładka
                int fileId = Article.FileId;
                if (photos.Count > 0)
                {
                    fileId = await fileService.UploadImage(photos[0].File);
                }

                await articleService.UpdateArticleByIdAsync(Article.Id, title, text, fileId, eventType);
                toastService.Success("Artykuł został zapisany.");
                ClearPhotos();
            }
            else
            {
                var fileIds = await fileService.UploadImagesAsync(photos.Select(p => p.File));
                await articleService.AddArticleAsync(title, text, fileIds, eventType);
                toastService.Success("Artykuł został dodany.");

                // czyścimy formularz, żeby nie dodać tego samego artykułu dwa razy
                title = "";
                text = "";
                eventType = null;
                ClearPhotos();
            }
        }
        catch (Exception)
        {
            toastService.Error("Nie udało się zapisać artykułu.");
        }
    }

    private async Task DeleteAsync()
    {
        if (!CanDelete || Article == null)
        {
            return;
        }

        try
        {
            await articleService.RemoveArticleByIdAsync(Article.Id);
            toastService.Success("Artykuł został usunięty.");
            await OnDeleted.InvokeAsync();
        }
        catch (Exception)
        {
            toastService.Error("Nie udało się usunąć artykułu.");
        }
    }

    private async Task ChoosePhotos(InputFileChangeEventArgs e)
    {
        IReadOnlyList<IBrowserFile> selected;
        try
        {
            selected = e.GetMultipleFiles(IsEdit ? 1 : MaxFiles);
        }
        catch (InvalidOperationException)
        {
            toastService.Error($"Możesz wybrać maksymalnie {MaxFiles} zdjęć naraz.");
            return;
        }

        // przy edycji nowe zdjęcie zastępuje poprzedni wybór
        if (IsEdit)
        {
            photos.Clear();
        }

        foreach (var f in selected)
        {
            if (photos.Count >= MaxFiles)
            {
                break;
            }

            try
            {
                photos.Add((f, await fileService.GetPreviewAsync(f)));
            }
            catch (Exception)
            {
                toastService.Error($"Nie udało się wczytać pliku {f.Name} (maks. 5 MB).");
            }
        }
    }

    private void RemovePhoto(int index) => photos.RemoveAt(index);

    private void ClearPhotos()
    {
        photos.Clear();
        formKey++;
    }
}

@using SchoolNewspaperBlazorApp.Data
@using SchoolNewspaperBlazorApp.Interfaces.Service
@using SchoolNewspaperBlazorApp.Service
@inject IArticleService articleService
@inject IFileService fileService
@inject ToastService toastService

<div class="add-article-form">
    <h1 class="add-article-form__title">Dodaj artykuł</h1>

    @if (previewImage != null)
    {
        <div class="image-preview-wrap">
            <img src="@previewImage" alt="zdjęcie" class="image-preview" />
        </div>
    }

    <label class="form-label">Zdjęcie</label>
    <InputFile @key="formKey" OnChange="ChoosePhoto" accept="image/*" class="form-control mb-3" />

    <form @onsubmit="SubmitForm" @onsubmit:preventDefault>
        <label class="form-label">Tytuł</label>
        <input @bind="title" class="form-control mb-3" placeholder="Wpisz tytuł..." />

        <label class="form-label">Treść</label>
        <textarea @bind="text" class="form-control mb-3" rows="6" placeholder="Treść artykułu..."></textarea>

        <label class="form-label">Autor</label>
        <input @bind="author" class="form-control mb-4" placeholder="Imię i nazwisko" />

        <button type="submit" class="btn btn-primary w-100">@( IsEdit ? "Zatwierdź edycje" : "Dodaj artykuł")</button>

        @if (IsEdit && CanDelete)
        {
            <button type="button" class="btn btn-outline-danger w-100 mt-2" @onclick="DeleteAsync">
                Usuń artykuł
            </button>
        }
    </form>
</div>


@code {
    [Parameter]
    public bool IsEdit { get; set; }
    [Parameter]
    public Article? Article { get; set; }
    [Parameter]
    public bool CanDelete { get; set; }
    [Parameter]
    public EventCallback OnDeleted { get; set; }
    private string title = "";
    private string text = "";
    private string author = "";
    private string? previewImage;
    private int formKey;
    IBrowserFile? file;

    protected override void OnParametersSet()
    {
        if (IsEdit && Article != null)
        {
            title = Article.Title;
            text = Article.Text;
            author = Article.Author;
        }
    }

    private async Task SubmitForm()
    {
        if (!IsEdit && file == null)
        {
            toastService.Error("Dodając artykuł, musisz dodać zdjęcie.");
            return;
        }

        try
        {
            // przy edycji bez nowego zdjęcia zostaje dotychczasowe (wcześniej wpadało tu 0)
            int id = IsEdit && Article != null ? Article.FileId : 0;
            if (file != null)
            {
                id = await fileService.UploadImage(file);
            }

            if (IsEdit && Article != null)
            {
                await articleService.UpdateArticleByIdAsync(Article.Id, title, text, author, id);
                toastService.Success("Artykuł został zapisany.");
                ClearPhoto();
            }
            else
            {
                await articleService.AddArticleAsync(title, text, author, id);
                toastService.Success("Artykuł został dodany.");

                // czyścimy formularz, żeby nie dodać tego samego artykułu dwa razy
                title = "";
                text = "";
                author = "";
                ClearPhoto();
            }
        }
        catch (Exception)
        {
            toastService.Error("Nie udało się zapisać artykułu.");
        }
    }

    private async Task DeleteAsync()
    {
        if (!CanDelete || Article == null)
        {
            return;
        }

        try
        {
            await articleService.RemoveArticleByIdAsync(Article.Id);
            toastService.Success("Artykuł został usunięty.");
            await OnDeleted.InvokeAsync();
        }
        catch (Exception)
        {
            toastService.Error("Nie udało się usunąć artykułu.");
        }
    }

    private async Task ChoosePhoto(InputFileChangeEventArgs e)
    {
        file = e.File;
        previewImage = await fileService.GetPreviewAsync(file);
    }

    private void ClearPhoto()
    {
        file = null;
        previewImage = null;
        formKey++;
    }
}

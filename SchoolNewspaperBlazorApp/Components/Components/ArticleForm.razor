@using SchoolNewspaperBlazorApp.Data
@using SchoolNewspaperBlazorApp.Interfaces.Service
@inject IArticleService articleService
@inject IFileService fileService

<div class="form-card">
    <h2 class="form-card__title">Dodaj artykuł</h2>

    @if (saved)
    {
        <p class="form-status" role="status">Artykuł został dodany.</p>
    }

    @if (previewImage != null)
    {
        <div class="image-preview">
            <img src="@previewImage" alt="Podgląd zdjęcia" />
        </div>
    }

    <div class="field">
        <label class="form-label" for="photo">Zdjęcie</label>
        <div class="dropzone">
            <svg class="dropzone__icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 16V4M7 9l5-5 5 5" />
                <path d="M4 16v2.5A1.5 1.5 0 0 0 5.5 20h13a1.5 1.5 0 0 0 1.5-1.5V16" />
            </svg>
            <span class="dropzone__title">@(file is null ? "Przeciągnij zdjęcie lub kliknij, aby wybrać" : file.Name)</span>
            <span class="dropzone__hint">JPG, PNG lub WebP</span>
            <InputFile id="photo" @key="formKey" OnChange="ChoosePhoto" accept="image/*" class="dropzone__input" />
        </div>
    </div>

    <form @onsubmit="AddArticle" @onsubmit:preventDefault>
        <div class="field">
            <label class="form-label" for="title">Tytuł</label>
            <input id="title" @bind="title" class="form-control" placeholder="Wpisz tytuł..." />
        </div>

        <div class="field">
            <label class="form-label" for="text">Treść</label>
            <textarea id="text" @bind="text" class="form-control" rows="6" placeholder="Treść artykułu..."></textarea>
        </div>

        <div class="field">
            <label class="form-label" for="author">Autor</label>
            <input id="author" @bind="author" class="form-control" placeholder="Imię i nazwisko" />
        </div>

        <button type="submit" class="btn btn-primary w-100 mt-2">Dodaj artykuł</button>
    </form>
</div>

@code {
    private string title = "";
    private string text = "";
    private string author = "";
    private string? previewImage;
    private bool saved;
    private int formKey;
    IBrowserFile? file;

    private async Task ChoosePhoto(InputFileChangeEventArgs e)
    {
        saved = false;
        file = e.File;
        previewImage = await fileService.GetPreviewAsync(file);
    }

    private async Task AddArticle()
    {
        int id = 0;
        if(file != null)
        {
            id = await fileService.UploadImage(file);
        }
        await articleService.AddArticleAsync(title, text, author, id);

        // czyścimy formularz, żeby nie dodać tego samego artykułu dwa razy
        title = "";
        text = "";
        author = "";
        file = null;
        previewImage = null;
        formKey++;
        saved = true;
    }
}

@using Microsoft.AspNetCore.Components.Authorization
@using SchoolNewspaperBlazorApp.Data
@using SchoolNewspaperBlazorApp.Interfaces.Service
@inject IAuthService _authService;
@inject AuthenticationStateProvider _asp;
@foreach(var user in Users)
{
    <div class="article-card">
        <div class="article-card__body">
            <h5 class="article-card__title">Uprawnienia użytkownika: @user.Value</h5>
            @foreach (var permission in Enum.GetValues<EnumPermissions>()
                          .Where(p => p != EnumPermissions.Master))
            {
                <div class="form-check mb-2" @key="permission">
                    <input class="form-check-input"
                           type="checkbox"
                           id="@($"permission-{user.Key}-{permission}")"/>
                    <label class="form-check-label"
                           for="@($"permission-{user.Key}-{permission}")">
                        @GetPermissionName(permission);
                    </label>
                </div>
            }
        </div>  
    </div>
}

@code {
    public Dictionary<int,string> Users { get; set; } = new Dictionary<int, string>();
    private int? ExpendedUserId { get; set; }
    private Dictionary<EnumPermissions, bool> SelectedPermissions { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        Users =  await _authService.GetAllUsersAsync();
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(firstRender)
        {
            Users = await _authService.GetAllUsersAsync();
            StateHasChanged();
        }
    }

    private void TogglePermission(int userId)
    {
        if (ExpendedUserId == userId)
        {
            ExpendedUserId = null;
            return;
        }
    }

    private String GetPermissionName(EnumPermissions permission)
    {
        return Enum.GetName(typeof(EnumPermissions), permission);
    }
    
    
}
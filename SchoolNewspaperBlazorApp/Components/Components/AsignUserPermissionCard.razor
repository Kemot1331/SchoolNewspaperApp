@using SchoolNewspaperBlazorApp.Data
@using SchoolNewspaperBlazorApp.Interfaces.Service
@using SchoolNewspaperBlazorApp.Service
@inject IAuthService authService
@inject IPermissionService permissionService
@inject ToastService toastService


@if (!string.IsNullOrEmpty(message))
{
    <p class="form-status" role="status">@message</p>
}

@if (!string.IsNullOrEmpty(error))
{
    <p class="form-error" role="alert">@error</p>
}

@if (Users.Count == 0)
{
    <p class="empty-state">Nie ma jeszcze żadnych użytkowników.</p>
}
else
{
    <div class="article-grid">
        <ToastHost></ToastHost>
        @foreach (var user in Users)
        {
            var isOpen = expandedUserId == user.Key;

            <div class="article-card" @key="user.Key">
                <div class="article-card__body">
                    <h5 class="article-card__title">@DisplayName(user.Key, user.Value)</h5>

                    @if (isOpen)
                    {
                        <div class="mb-3">
                            @foreach (var permission in Editable)
                            {
                                <div class="form-check mb-2" @key="permission">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           id="@($"permission-{user.Key}-{permission}")"
                                           checked="@selected.Contains(permission)"
                                           @onchange="e => SetPermission(permission, e)"/>
                                    <label class="form-check-label"
                                           for="@($"permission-{user.Key}-{permission}")">
                                        @PermissionLabel(permission)
                                    </label>
                                </div>
                            }
                        </div>

                        <div class="d-flex flex-wrap gap-2">
                            <button type="button" class="btn btn-primary" disabled="@saving" @onclick="SaveAsync">
                                Zapisz
                            </button>
                            <button type="button" class="btn btn-outline-primary" @onclick="() => ToggleUserAsync(user.Key)">
                                Anuluj
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => confirmDeleteId = user.Key">
                                Usuń użytkownika
                            </button>
                        </div>

                        @if (confirmDeleteId == user.Key)
                        {
                            <div class="d-flex flex-wrap align-items-center gap-2 mt-3">
                                <span class="small">Na pewno usunąć to konto?</span>
                                <button type="button" class="btn btn-sm btn-danger" disabled="@saving" @onclick="() => DeleteUserAsync(user.Key)">
                                    Tak, usuń
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => confirmDeleteId = null">
                                    Nie
                                </button>
                            </div>
                        }
                    }
                    else
                    {
                        <button type="button" class="btn btn-outline-primary" @onclick="() => ToggleUserAsync(user.Key)">
                            Edytuj uprawnienia
                        </button>
                    }
                </div>
            </div>
        }
    </div>
}

@code {
    // Master celowo pomijamy – tego uprawnienia nie nadaje się z panelu
    private static readonly EnumPermissions[] Editable =
        Enum.GetValues<EnumPermissions>().Where(p => p != EnumPermissions.Master).ToArray();

    private Dictionary<int, string> Users = new();
    private readonly Dictionary<int, string> fullNames = new();
    private int? expandedUserId;
    private int? confirmDeleteId;
    private HashSet<EnumPermissions> selected = new();
    private bool saving;
    private string? message;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        Users = await authService.GetAllUsersAsync();

        // imię i nazwisko każdego użytkownika (jedno proste zapytanie na konto)
        foreach (var id in Users.Keys)
        {
            fullNames[id] = await authService.GetFullNameAsync(id);
        }
    }

    // "Imię Nazwisko (e-mail)"; dla konta bez imienia i nazwiska sam e-mail
    private string DisplayName(int id, string email)
    {
        var fullName = fullNames.GetValueOrDefault(id, "");
        return string.IsNullOrWhiteSpace(fullName) ? email : $"{fullName} ({email})";
    }

    private async Task ToggleUserAsync(int userId)
    {
        message = null;
        error = null;
        confirmDeleteId = null;

        if (expandedUserId == userId)
        {
            expandedUserId = null;
            return;
        }

        var current = await permissionService.GetUserPermissionsAsync(userId);
        selected = current.ToHashSet();
        expandedUserId = userId;
    }

    private void SetPermission(EnumPermissions permission, ChangeEventArgs e)
    {
        if (e.Value is true)
        {
            selected.Add(permission);
        }
        else
        {
            selected.Remove(permission);
        }
    }

    private async Task SaveAsync()
    {
        if (expandedUserId is not int userId)
        {
            return;
        }

        saving = true;
        message = null;
        error = null;

        try
        {
            await permissionService.SetUserPermissionsAsync(userId, selected);
            message = $"Zapisano uprawnienia użytkownika {DisplayName(userId, Users[userId])}.";
            expandedUserId = null;
        }
        catch (UnauthorizedAccessException)
        {
            toastService.Error("Nie masz uprawnień do zmiany uprawnień użytkowników.");
        }
        catch (Exception)
        {
            toastService.Error("Nie udało się zapisać uprawnień.");
        }
        finally
        {
            saving = false;
        }
    }

    private async Task DeleteUserAsync(int userId)
    {
        saving = true;
        message = null;
        error = null;

        try
        {
            var name = DisplayName(userId, Users.GetValueOrDefault(userId, ""));

            await authService.DeleteUserByIdAsync(userId);

            Users.Remove(userId);
            fullNames.Remove(userId);
            expandedUserId = null;
            toastService.Success($"Usunięto użytkownika {name}.");
        }
        catch (UnauthorizedAccessException)
        {
            toastService.Error("Nie masz uprawnień do usuwania użytkowników.");
        }
        catch (InvalidOperationException ex)
        {
            // własne konto lub konto administratora
            toastService.Error(ex.Message);
        }
        catch (Exception)
        {
            toastService.Error("Nie udało się usunąć użytkownika.");
        }
        finally
        {
            confirmDeleteId = null;
            saving = false;
        }
    }

    private static string PermissionLabel(EnumPermissions permission) => permission switch
    {
        EnumPermissions.AddArticle => "Dodawanie artykułów",
        EnumPermissions.EditArticle => "Edycja artykułów",
        EnumPermissions.DeleteArticle => "Usuwanie artykułów",
        EnumPermissions.AddUser => "Dodawanie użytkowników",
        EnumPermissions.ManageUser => "Zarządzanie użytkownikami",
        _ => permission.ToString()
    };
}

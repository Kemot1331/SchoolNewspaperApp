@using SchoolNewspaperBlazorApp.Interfaces.Service
@using SchoolNewspaperBlazorApp.Service
@inject IAuthService authService
@inject ToastService toastService


<form @onsubmit="AddUserAsync" @onsubmit:preventDefault>
    <label class="form-label">Login</label>
    <input @bind="Login" class="form-control mb-3" placeholder="Login" autocomplete="off" />

    <label class="form-label">E-mail</label>
    <input @bind="Email" type="email" class="form-control mb-3" placeholder="E-Mail" autocomplete="off" />
    
    <label class="form-label">Imię:</label>
    <input @bind="FirstName" type="text" class="form-control mb-3" placeholder="Imię" autocomplete="off" />
    
    <label class="form-label">Nazwisko:</label>
    <input @bind="LastName" type="text" class="form-control mb-3" placeholder="Nazwisko" autocomplete="off" />

    <label class="form-label">Hasło</label>
    <input @bind="Password" type="password" class="form-control mb-4" placeholder="Hasło" autocomplete="new-password" />

    <button type="submit" class="btn btn-primary w-100">Dodaj</button>
</form>


@code {
    private string Login { get; set; } = "";
    private string Password { get; set; } = "";
    private string Email { get; set; } = "";
    private string FirstName { get; set; } = "";
    private string LastName { get; set; } = "";

    private async Task AddUserAsync()
    {
        if (string.IsNullOrWhiteSpace(Login) || string.IsNullOrWhiteSpace(Password) || string.IsNullOrWhiteSpace(Email))
        {
            toastService.Error("Uzupełnij wszystkie pola.");
            return;
        }

        try
        {
            await authService.AddUserAsync(Login.Trim(), Password, Email.Trim(), FirstName.Trim(), LastName.Trim());
            toastService.Success("Dodano użytkownika.");

            Login = "";
            Email = "";
            Password = "";
            FirstName = "";
            LastName = "";
        }
        catch (Exception)
        {
            toastService.Error("Nie udało się dodać użytkownika.");
        }
    }
}
@page "/zmiana-hasla"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
<PageTitle>Zmiana hasła | Gazetka ETI</PageTitle>

<main class="login-panel" style="min-height: 70vh;">
    <div class="login-card">
        <div class="login-heading">
            <h1>Ustaw nowe hasło</h1>
            <p>Hasło dla Twojego konta zostało nadane przez administratora. Zanim przejdziesz dalej, ustaw własne (min. 8 znaków).</p>
        </div>

        @if (!string.IsNullOrWhiteSpace(Error))
        {
            <div class="login-error" role="alert">@Error</div>
        }

        <form action="/auth/change-password" method="post">

            <div class="login-field">
                <label for="cp-current">Obecne hasło</label>
                <div class="login-input-wrapper">
                    <span class="login-field-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none">
                            <rect x="4" y="10" width="16" height="11" rx="3" stroke="currentColor" stroke-width="1.7" />
                            <path d="M8 10V7a4 4 0 0 1 8 0v3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
                            <circle cx="12" cy="15" r="1.3" fill="currentColor" />
                        </svg>
                    </span>
                    <input id="cp-current" type="password" name="CurrentPassword" class="login-input"
                           placeholder="Hasło od administratora" autocomplete="current-password" required />
                </div>
            </div>

            <div class="login-field">
                <label for="cp-new">Nowe hasło</label>
                <div class="login-input-wrapper">
                    <span class="login-field-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none">
                            <rect x="4" y="10" width="16" height="11" rx="3" stroke="currentColor" stroke-width="1.7" />
                            <path d="M8 10V7a4 4 0 0 1 8 0v3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
                            <circle cx="12" cy="15" r="1.3" fill="currentColor" />
                        </svg>
                    </span>
                    <input id="cp-new" type="password" name="NewPassword" class="login-input"
                           placeholder="Nowe hasło" autocomplete="new-password" minlength="8" required />
                </div>
            </div>

            <div class="login-field">
                <label for="cp-confirm">Powtórz nowe hasło</label>
                <div class="login-input-wrapper">
                    <span class="login-field-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none">
                            <rect x="4" y="10" width="16" height="11" rx="3" stroke="currentColor" stroke-width="1.7" />
                            <path d="M8 10V7a4 4 0 0 1 8 0v3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
                            <circle cx="12" cy="15" r="1.3" fill="currentColor" />
                        </svg>
                    </span>
                    <input id="cp-confirm" type="password" name="ConfirmPassword" class="login-input"
                           placeholder="Powtórz nowe hasło" autocomplete="new-password" minlength="8" required />
                </div>
            </div>

            <button type="submit" class="login-button">
                Zapisz hasło <span aria-hidden="true">→</span>
            </button>
        </form>
    </div>
</main>

@code {
    // komunikat błędu wraca w adresie: /zmiana-hasla?error=...
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }
}

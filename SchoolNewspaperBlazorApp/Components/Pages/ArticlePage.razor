@page "/article/{Id:int}"

@using SchoolNewspaperBlazorApp.Data
@using SchoolNewspaperBlazorApp.Interfaces.Service

<PageTitle>@(article is null ? "Artykuł" : article.Title) | Gazetka ETI</PageTitle>

@if (notFound)
{
    <section class="home-hero">
        <span class="home-hero__eyebrow">Gazetka szkolna</span>
        <h1>Nie znaleziono artykułu</h1>
        <p>Ten artykuł nie istnieje albo został usunięty.</p>
        <a href="/aktualnosci" class="home-hero__button">
            Wróć do aktualności <span aria-hidden="true">→</span>
        </a>
    </section>
}
else if (article != null)
{
    <article class="article-page">

        @if (!string.IsNullOrEmpty(imageUrl))
        {
            <div class="article-page__img-wrap">
                <img src="@imageUrl" alt="@article.Title" class="article-page__img" />
            </div>
        }

        <h1 class="article-page__title">@article.Title</h1>


        <div class="article-page__content">
            @foreach (var block in blocks)
            {
                if (!string.IsNullOrWhiteSpace(block.Text))
                {
                    <p class="article-page__paragraph">@block.Text</p>
                }
                if (block.ImageFileId is int fid && blockImageUrls.TryGetValue(fid, out var blockUrl))
                {
                    <figure class="article-page__figure">
                        <img src="@blockUrl" alt="@article.Title" loading="lazy" />
                    </figure>
                }
            }
        </div>

        @if (galleryUrls.Count > 0)
        {
            <div class="article-gallery"
                 style="display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: .75rem; margin: 2rem 0;">
                @foreach (var url in galleryUrls)
                {
                    <a href="@url" target="_blank" rel="noopener"
                       style="display: block; overflow: hidden; border: 1px solid #dde3ec; border-radius: 12px; background: #f3f5f9;">
                        <img src="@url" alt="@article.Title" loading="lazy"
                             style="display: block; width: 100%; max-width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: contain;" />
                    </a>
                }
            </div>
        }

        <div class="article-page__meta">
            <span class="article-page__author">@article.AuthorDisplay</span>
        </div>
    </article>
}

@code {
    [Parameter]
    public int Id { get; set; }

    public Article? article;
    private bool notFound;
    private string? imageUrl;
    private List<string> galleryUrls = new();
    private List<ArticleContent.Block> blocks = new();
    private readonly Dictionary<int, string> blockImageUrls = new();

    [Inject]
    public IArticleService articleService { get; set; } = default!;

    [Inject]
    public IFileService fileService { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            article = await articleService.GetArticleByIdAsync(Id);
        }
        catch (KeyNotFoundException)
        {
            // brak artykułu albo został usunięty – pokazujemy czytelną stronę zamiast błędu 500
            notFound = true;
            return;
        }

        var coverName = await fileService.TryGetFileNameByIdAsync(article.FileId);
        if (coverName != null)
        {
            imageUrl = $"/Images/{coverName}";
        }

        blocks = ArticleContent.Parse(article.Text);
        foreach (var fileId in blocks.Where(b => b.ImageFileId.HasValue).Select(b => b.ImageFileId!.Value).Distinct())
        {
            // brak pliku w bazie – akapit zostaje bez zdjęcia
            var blockName = await fileService.TryGetFileNameByIdAsync(fileId);
            if (blockName != null)
            {
                blockImageUrls[fileId] = $"/Images/{blockName}";
            }
        }

        var galleryImages = (article.Images ?? new List<ArticleImage>())
            .Where(i => i.FileId != article.FileId)
            .OrderBy(i => i.Order);

        foreach (var image in galleryImages)
        {
            var name = await fileService.TryGetFileNameByIdAsync(image.FileId);
            if (name != null)
            {
                galleryUrls.Add($"/Images/{name}");
            }
        }
    }
}

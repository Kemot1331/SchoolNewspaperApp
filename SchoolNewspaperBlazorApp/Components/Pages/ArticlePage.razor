@page "/article/{Id:int}"

@using SchoolNewspaperBlazorApp.Data
@using SchoolNewspaperBlazorApp.Interfaces.Service

@if (article != null)
{
    <PageTitle>@article.Title</PageTitle>

    <article class="article-page">
        <a class="article-page__back" href="/">← Wszystkie artykuły</a>

        <h1 class="article-page__title">@article.Title</h1>

        <div class="article-page__meta">
            <span class="avatar" aria-hidden="true">@AuthorInitial</span>
            <span>Autor: <span class="article-page__author">@article.Author</span></span>
            <span class="article-page__dot" aria-hidden="true">•</span>
            <span>@ReadingMinutes min czytania</span>
        </div>

        @if (!string.IsNullOrEmpty(imageUrl))
        {
            <figure class="article-page__img-wrap">
                <img src="@imageUrl" alt="@article.Title" class="article-page__img" />
            </figure>
        }

        <div class="article-page__content">
            @foreach (var paragraph in Paragraphs)
            {
                <p>@paragraph</p>
            }
        </div>
    </article>
}
else
{
    <PageTitle>Nie znaleziono artykułu</PageTitle>

    <div class="empty-state">
        <strong>Nie znaleziono artykułu</strong>
        <span>Być może został usunięty. <a href="/">Wróć na stronę główną</a>.</span>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    public Article? article;
    private string? imageUrl;

    [Inject]
    public IArticleService articleService { get; set; } = default!;

    [Inject]
    public IFileService fileService { get; set; } = default!;

    private IEnumerable<string> Paragraphs =>
        (article?.Text ?? "").Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    private string AuthorInitial =>
        string.IsNullOrWhiteSpace(article?.Author) ? "?" : article!.Author.Trim()[0].ToString().ToUpperInvariant();

    private int ReadingMinutes
    {
        get
        {
            var words = (article?.Text ?? "")
                .Split(new[] { ' ', '\n', '\r', '\t' }, StringSplitOptions.RemoveEmptyEntries).Length;
            return Math.Max(1, (int)Math.Ceiling(words / 200.0));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        article = await articleService.GetArticleByIdAsync(Id);

        if (article != null)
        {
            var fileName = await fileService.GetFileNameByIdAsync(article.FileId);
            if (!string.IsNullOrWhiteSpace(fileName))
            {
                imageUrl = $"/Images/{fileName}";
            }
        }
    }
}

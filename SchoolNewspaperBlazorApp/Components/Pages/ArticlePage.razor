@page "/article/{Id:int}"

@using SchoolNewspaperBlazorApp.Data
@using SchoolNewspaperBlazorApp.Interfaces.Service

@if (article != null)
{
    <PageTitle>@article.Title</PageTitle>

    <article class="article-page">
        <a class="article-page__back" href="/">← Wszystkie artykuły</a>

        <h1 class="article-page__title">@article.Title</h1>

        <p class="article-page__meta">Autor: <span class="article-page__author">@article.Author</span></p>

        @if (!string.IsNullOrEmpty(imageUrl))
        {
            <div class="article-page__img-wrap">
                <img src="@imageUrl" alt="@article.Title" class="article-page__img" />
            </div>
        }

        <div class="article-page__content">
            @foreach (var paragraph in Paragraphs)
            {
                <p>@paragraph</p>
            }
        </div>
    </article>
}

@code {
    [Parameter]
    public int Id { get; set; }

    public Article? article;
    private string? imageUrl;

    [Inject]
    public IArticleService articleService { get; set; } = default!;

    [Inject]
    public IFileService fileService { get; set; } = default!;

    private IEnumerable<string> Paragraphs =>
        (article?.Text ?? "").Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    protected override async Task OnInitializedAsync()
    {
        article = await articleService.GetArticleByIdAsync(Id);

        if (article != null)
        {
            var fileName = await fileService.GetFileNameByIdAsync(article.FileId);
            if (!string.IsNullOrWhiteSpace(fileName))
            {
                imageUrl = $"/Images/{fileName}";
            }
        }
    }
}

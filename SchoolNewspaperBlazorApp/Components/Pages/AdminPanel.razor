@page "/adminPanel"
@rendermode InteractiveServer
@inject IPermissionService permissionService
@inject IArticleService articleService
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using SchoolNewspaperBlazorApp.Components.Components
@using SchoolNewspaperBlazorApp.Data
@using SchoolNewspaperBlazorApp.Interfaces.Service
<div class="admin-page">

    <ToastHost />

    <section class="admin-header">
        <div class="admin-header__content">
            <span class="admin-header__eyebrow">
                ETI / STREFA ZARZĄDZANIA
            </span>

            <h1>Panel administratora</h1>

            <p>
                Zarządzaj publikacjami i użytkownikami gazetki szkolnej
                w jednym miejscu.
            </p>

            <div class="admin-header__status">
                <span class="site-status__dot"></span>
                Centrum zarządzania gazetką
            </div>
        </div>

        <div class="admin-header__emblem" aria-hidden="true">
            <img src="/logo.png" alt="" />
        </div>
    </section>

    @if (!hasAnyPermission)
    {
        <section class="admin-content-panel">
            <div class="admin-empty-state">
                <span class="admin-empty-state__icon">♙</span>
                <h3>Brak uprawnień</h3>
                <p>
                    Twoje konto nie ma jeszcze żadnych uprawnień.
                    Skontaktuj się z administratorem gazetki.
                </p>
            </div>
        </section>
    }
    else if (view == 0)
    {
        <div class="admin-section-heading">
            <div>
                <span class="admin-section-heading__eyebrow">
                    MENU GŁÓWNE
                </span>
                <h2>Co chcesz zrobić?</h2>
                <p>Wybierz jedną z dostępnych funkcji panelu.</p>
            </div>
        </div>

        <div class="admin-actions">
            @if (canEditArticle)
            {
                <button type="button"
                        class="admin-action"
                        @onclick="LoadArticleAsync">

                    <span class="admin-action__icon">▤</span>

                    <span class="admin-action__number">01</span>

                    <strong>Panel artykułów</strong>

                    <span class="admin-action__description">
                        Przeglądaj publikacje i zarządzaj istniejącymi artykułami.
                    </span>

                    <span class="admin-action__footer">
                        Otwórz artykuły <span>→</span>
                    </span>
                </button>
            }

            @if (canAddArticle)
            {
                <button type="button"
                        class="admin-action"
                        @onclick="() => SetView(2)">

                    <span class="admin-action__icon">✎</span>

                    <span class="admin-action__number">02</span>

                    <strong>Dodaj artykuł</strong>

                    <span class="admin-action__description">
                        Przygotuj nową publikację i dodaj ją do gazetki szkolnej.
                    </span>

                    <span class="admin-action__footer">
                        Utwórz artykuł <span>→</span>
                    </span>
                </button>
            }

            @if (canAddUser)
            {
                <button type="button"
                        class="admin-action"
                        @onclick="() => SetView(3)">

                    <span class="admin-action__icon">♙</span>

                    <span class="admin-action__number">03</span>

                    <strong>Dodaj użytkownika</strong>

                    <span class="admin-action__description">
                        Dodaj konto użytkownika do systemu gazetki.
                    </span>

                    <span class="admin-action__footer">
                        Dodaj konto <span>→</span>
                    </span>
                </button>
            }

            @if (canManageUsers)
            {
                <button type="button"
                        class="admin-action"
                        @onclick="() => SetView(5)">

                    <span class="admin-action__icon">✎</span>

                    <span class="admin-action__number">04</span>

                    <strong>Nadaj uprawnienia</strong>

                    <span class="admin-action__description">
                        Edytuj uprawnienia użytkowników
                    </span>

                    <span class="admin-action__footer">
                        Nadaj uprawnienia <span>→</span>
                    </span>
                </button>
            }

            @if (canManageUsers)
            {
                <button type="button"
                        class="admin-action"
                        @onclick="() => SetView(6)">

                    <span class="admin-action__icon">★</span>

                    <span class="admin-action__number">05</span>

                    <strong>Nadaj rolę</strong>

                    <span class="admin-action__description">
                        Przypisz użytkownikom role widoczne przy ich artykułach.
                    </span>

                    <span class="admin-action__footer">
                        Nadaj rolę <span>→</span>
                    </span>
                </button>
            }

            @if (canManageUsers)
            {
                <button type="button"
                        class="admin-action"
                        @onclick="() => SetView(7)">

                    <span class="admin-action__icon">⚙</span>

                    <span class="admin-action__number">06</span>

                    <strong>Zarządzaj użytkownikami</strong>

                    <span class="admin-action__description">
                        Edytuj dane kont użytkowników albo usuń konta.
                    </span>

                    <span class="admin-action__footer">
                        Zarządzaj kontami <span>→</span>
                    </span>
                </button>
            }

            @if (canAddSubstitution)
            {
                <button type="button"
                        class="admin-action"
                        @onclick="() => SetView(8)">

                    <span class="admin-action__icon">⇄</span>

                    <span class="admin-action__number">07</span>

                    <strong>Dodaj zastępstwo</strong>

                    <span class="admin-action__description">
                        Zgłoś zastępstwo, odwołaną lekcję albo zmianę sali.
                    </span>

                    <span class="admin-action__footer">
                        Dodaj zastępstwo <span>→</span>
                    </span>
                </button>
            }

            @if (canManageSubstitution)
            {
                <button type="button"
                        class="admin-action"
                        @onclick="() => SetView(9)">

                    <span class="admin-action__icon">☰</span>

                    <span class="admin-action__number">08</span>

                    <strong>Lista zastępstw</strong>

                    <span class="admin-action__description">
                        Edytuj albo usuń dodane zastępstwa.
                    </span>

                    <span class="admin-action__footer">
                        Zarządzaj zastępstwami <span>→</span>
                    </span>
                </button>
            }

            @if (canManageDictionaries)
            {
                <button type="button"
                        class="admin-action"
                        @onclick="() => SetView(10)">

                    <span class="admin-action__icon">▦</span>

                    <span class="admin-action__number">09</span>

                    <strong>Klasy, nauczyciele, sale, przedmioty</strong>

                    <span class="admin-action__description">
                        Uzupełnij słowniki używane w formularzu zastępstw.
                    </span>

                    <span class="admin-action__footer">
                        Zarządzaj słownikami <span>→</span>
                    </span>
                </button>
            }

        </div>

        <section class="admin-section">
            <div class="admin-section__title-row">
                <span class="admin-section__symbol">✦</span>
                <div>
                    <h2>Witaj w centrum zarządzania</h2>
                    <p>
                        Wybierz odpowiednią kartę powyżej, aby rozpocząć pracę.
                    </p>
                </div>
            </div>
        </section>
    }
    else
    {
        <div class="admin-back-row">
            <button type="button"
                    class="admin-back-button"
                    @onclick="() => SetView(0)">
                <span>←</span> Wróć do panelu
            </button>

            <div class="admin-current-view">
                <span class="site-status__dot"></span>

                @if (view == 1)
                {
                    <span>Zarządzanie artykułami</span>
                }
                else if (view == 2)
                {
                    <span>Tworzenie artykułu</span>
                }
                else if (view == 3)
                {
                    <span>Dodawanie użytkownika</span>
                }
                else if (view == 6)
                {
                    <span>Nadawanie ról</span>
                }
                else if (view == 7)
                {
                    <span>Zarządzanie użytkownikami</span>
                }
                else if (view == 8)
                {
                    <span>Dodawanie zastępstwa</span>
                }
                else if (view == 9)
                {
                    <span>Zarządzanie zastępstwami</span>
                }
                else if (view == 10)
                {
                    <span>Słowniki zastępstw</span>
                }
            </div>
        </div>

        @if (view == 1)
        {
            <section class="admin-content-panel">
                <div class="admin-content-panel__header">
                    <div>
                        <span class="admin-section-heading__eyebrow">
                            PUBLIKACJE
                        </span>
                        <h2>Panel artykułów</h2>
                        <p>Zarządzaj artykułami opublikowanymi w gazetce.</p>
                    </div>

                    @if (canAddArticle)
                    {
                        <button type="button"
                                class="admin-small-button"
                                @onclick="() => SetView(2)">
                            + Dodaj artykuł
                        </button>
                    }
                </div>

                @if (articleList.Count == 0)
                {
                    <div class="admin-empty-state">
                        <span class="admin-empty-state__icon">▤</span>
                        <h3>Brak artykułów</h3>
                        <p>
                            Nie znaleziono publikacji.
                        </p>

                        @if (canAddArticle)
                        {
                            <button type="button"
                                    class="admin-small-button"
                                    @onclick="() => SetView(2)">
                                Dodaj pierwszy artykuł
                            </button>
                        }
                    </div>
                }
                else
                {
                    <div class="article-panel">
                        <ArticleCard Articles="articleList"
                                     permissions="true"
                                     CanEdit="canEditArticle"
                                     CanDelete="canDeleteArticle"
                                     onEdit="LoadArticleToEditAsync" />
                    </div>
                }
            </section>
        }
        else if (view == 2)
        {
            <section class="admin-content-panel">
                <div class="admin-content-panel__header">
                    <div>
                        <span class="admin-section-heading__eyebrow">
                            NOWA PUBLIKACJA
                        </span>
                        <h2>Dodaj artykuł</h2>
                        <p>Uzupełnij formularz, aby przygotować publikację.</p>
                    </div>
                </div>

                <div class="admin-form-wrapper">
                    <ArticleForm IsEdit="false" />
                </div>
            </section>
        }
        else if (view == 3)
        {
            <section class="admin-content-panel">
                <div class="admin-content-panel__header">
                    <div>
                        <span class="admin-section-heading__eyebrow">
                            KONTA
                        </span>
                        <h2>Dodaj użytkownika</h2>
                        <p>Utwórz nowe konto w systemie gazetki.</p>
                    </div>
                </div>

                <div class="admin-form-wrapper">
                    <AddUserForm />
                </div>
            </section>
        }
        else if (view == 4)
        {
            <ArticleForm IsEdit="true"
                         Article="articleToEdit"
                         CanDelete="canDeleteArticle"
                         OnDeleted="AfterArticleDeletedAsync" />
        }
        else if (view == 5)
        {
            <AsignUserPermissionCard></AsignUserPermissionCard>
        }
        else if (view == 6)
        {
            <AssignRoleCard></AssignRoleCard>
        }
        else if (view == 7)
        {
            <ManageUsersCard></ManageUsersCard>
        }
        else if (view == 8)
        {
            <section class="admin-content-panel">
                <div class="admin-content-panel__header">
                    <div>
                        <span class="admin-section-heading__eyebrow">
                            PLAN LEKCJI
                        </span>
                        <h2>Dodaj zastępstwo</h2>
                        <p>Wybierz typ wpisu i uzupełnij dane – zmiana od razu pojawi się na stronie Zastępstwa.</p>
                    </div>
                </div>

                <div class="admin-form-wrapper">
                    <SubstitutionForm />
                </div>
            </section>
        }
        else if (view == 9)
        {
            <section class="admin-content-panel">
                <div class="admin-content-panel__header">
                    <div>
                        <span class="admin-section-heading__eyebrow">
                            PLAN LEKCJI
                        </span>
                        <h2>Lista zastępstw</h2>
                        <p>Najnowsze wpisy na górze. Edytuj je albo usuń.</p>
                    </div>

                    @if (canAddSubstitution)
                    {
                        <button type="button"
                                class="admin-small-button"
                                @onclick="() => SetView(8)">
                            + Dodaj zastępstwo
                        </button>
                    }
                </div>

                <SubstitutionsManageCard />
            </section>
        }
        else if (view == 10)
        {
            <section class="admin-content-panel">
                <div class="admin-content-panel__header">
                    <div>
                        <span class="admin-section-heading__eyebrow">
                            SŁOWNIKI
                        </span>
                        <h2>Klasy, nauczyciele, sale, przedmioty</h2>
                        <p>Te listy pojawiają się jako wybór w formularzu zastępstw.</p>
                    </div>
                </div>

                <DictionaryManagerCard />
            </section>
        }
    }

</div>

@code {
    public int view = 0;
    public List<Article> articleList = new List<Article>();
    public Article? articleToEdit;

    private bool canAddArticle;
    private bool canEditArticle;
    private bool canDeleteArticle;
    private bool canAddUser;
    private bool canManageUsers;
    private bool canAddSubstitution;
    private bool canManageSubstitution;
    private bool canManageClasses;
    private bool canManageTeachers;
    private bool canManageRooms;
    private bool canManageSubjects;

    // słowniki: wystarczy uprawnienie do któregokolwiek z czterech
    private bool canManageDictionaries =>
        canManageClasses || canManageTeachers || canManageRooms || canManageSubjects;

    private bool hasAnyPermission =>
        canAddArticle || canEditArticle || canDeleteArticle || canAddUser || canManageUsers
        || canAddSubstitution || canManageSubstitution || canManageDictionaries;

    protected override async Task OnInitializedAsync()
    {
        canAddArticle = await HasAsync(EnumPermissions.AddArticle);
        canEditArticle = await HasAsync(EnumPermissions.EditArticle);
        canDeleteArticle = await HasAsync(EnumPermissions.DeleteArticle);
        canAddUser = await HasAsync(EnumPermissions.AddUser);
        canManageUsers = await HasAsync(EnumPermissions.ManageUser);
        canAddSubstitution = await HasAsync(EnumPermissions.AddSubstitution);
        canManageSubstitution = await HasAsync(EnumPermissions.ManageSubstitution);
        canManageClasses = await HasAsync(EnumPermissions.ManageClasses);
        canManageTeachers = await HasAsync(EnumPermissions.ManageTeachers);
        canManageRooms = await HasAsync(EnumPermissions.ManageRooms);
        canManageSubjects = await HasAsync(EnumPermissions.ManageSubjects);
    }

    // Master ma dostęp do wszystkiego
    private async Task<bool> HasAsync(EnumPermissions permission)
    {
        return await permissionService.HasPermissionAsync(permission)
               || await permissionService.HasPermissionAsync(EnumPermissions.Master);
    }

    // Każdy widok ma swoje uprawnienie – odmawiamy też wtedy, gdy ktoś wywoła SetView inną drogą niż przyciskiem
    private bool CanOpen(int target) => target switch
    {
        0 => true,
        1 => canEditArticle || canDeleteArticle,
        2 => canAddArticle,
        3 => canAddUser,
        4 => canEditArticle,
        5 => canManageUsers,
        6 => canManageUsers,
        7 => canManageUsers,
        8 => canAddSubstitution,
        9 => canManageSubstitution,
        10 => canManageDictionaries,
        _ => false
    };

    public void SetView(int target)
    {
        if (!CanOpen(target))
        {
            return;
        }

        view = target;
    }

    public async Task LoadArticleAsync()
    {
        if (!CanOpen(1))
        {
            return;
        }

        articleList = await articleService.GetAllArticlesAsync();
        SetView(1);
    }

    public async Task AfterArticleDeletedAsync()
    {
        articleToEdit = null;
        articleList = await articleService.GetAllArticlesAsync();
        SetView(1);
    }

    public async Task LoadArticleToEditAsync(int id)
    {
        if (!CanOpen(4))
        {
            return;
        }

        articleToEdit = await articleService.GetArticleByIdAsync(id);
        SetView(4);
    }
}
